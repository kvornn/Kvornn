# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Cryptographic secret for session & signed file download HMAC tokens.
SESSION_SECRET="CHANGE_ME_32_BYTE_HEX_SECRET"

# ACCESS_KEY_PEPPER: Server-side HMAC pepper for hashing 30-char CSPRNG access keys.
ACCESS_KEY_PEPPER="CHANGE_ME_32_BYTE_KEY_PEPPER"

# Optional one-time 30-character CSPRNG bootstrap overrides for founder admin accounts.
# Leave blank to auto-generate fresh CSPRNG keys on initial setup.
BOOTSTRAP_PRIMARY_KEY=""
BOOTSTRAP_ARCHIVE_KEY=""
BOOTSTRAP_SECURITY_KEY=""

# CLOUDFLARE_TURNSTILE_SECRET_KEY / SITE_KEY: Optional production Cloudflare Turnstile WAF CAPTCHA keys.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# CLAMAV_SCAN_HOST: Optional ClamAV daemon host:port (e.g. 127.0.0.1:3310) for malware scanning.
CLAMAV_SCAN_HOST=""
