{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Synchronized Sentarika Archive member identity record stored in Firestore.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "username": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "rank": {
          "type": "string",
          "enum": ["UYE", "DESTEKCI", "ISLETME", "ADMIN"]
        },
        "preferredLang": {
          "type": "string",
          "enum": ["tr", "en"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "username", "rank", "preferredLang", "createdAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for user email and security metadata.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "updatedAt"]
    },
    "ConnectionCheck": {
      "title": "ConnectionCheck",
      "description": "Firestore connectivity verification document.",
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        }
      },
      "required": ["ok"]
    },
    "AdminRegistry": {
      "title": "AdminRegistry",
      "description": "Server-managed administrator role registry.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "profile": {
          "type": "string",
          "enum": ["PRIMARY_ADMIN", "ARCHIVE_ADMIN", "SECURITY_ADMIN"]
        }
      },
      "required": ["uid", "profile"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "Publicly non-sensitive member profile keyed by Firebase UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Owner-only PII subcollection isolating email addresses."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRegistry" },
      "description": "Protected administrator lookup documents."
    },
    "/test/{docId}": {
      "schema": { "$ref": "#/entities/ConnectionCheck" },
      "description": "Read-only connectivity test path."
    }
  }
}
