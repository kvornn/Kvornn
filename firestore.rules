rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() &&
        (
          request.auth.token.email == 'anonimhesap6506@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserAccount(data, userId) {
      return data.keys().hasAll(['uid', 'username', 'rank', 'preferredLang', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'username', 'rank', 'preferredLang', 'createdAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.username is string && data.username.size() >= 2 && data.username.size() <= 64 &&
        data.rank is string && data.rank in ['UYE', 'DESTEKCI', 'ISLETME', 'ADMIN'] &&
        data.preferredLang is string && data.preferredLang in ['tr', 'en'] &&
        data.createdAt is timestamp;
    }

    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'updatedAt']) &&
        data.uid is string && data.uid == userId && isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.updatedAt is timestamp;
    }

    // Connectivity probe document (read-only)
    match /test/{docId} {
      allow get: if isValidId(docId);
      allow list, create, update, delete: if false;
    }

    // Admin registry (server/console managed only)
    match /admins/{adminUid} {
      allow get: if isOwner(adminUid) || isAdmin();
      allow list, create, update, delete: if false;
    }

    // Synchronized user profile (no PII here)
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin() && resource.data.uid is string;
      allow create: if isValidId(userId) &&
        isVerified() &&
        isOwner(userId) &&
        isValidUserAccount(incoming(), userId) &&
        incoming().rank == 'UYE' &&
        incoming().createdAt == request.time;
      allow update: if isValidId(userId) &&
        isVerified() &&
        isValidUserAccount(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        (
          isAdmin() ||
          (
            isOwner(userId) &&
            incoming().rank == existing().rank &&
            incoming().diff(existing()).affectedKeys().hasOnly(['username', 'preferredLang'])
          )
        );
      allow delete: if false;

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if false;
        allow create: if isValidId(userId) && isValidId(docId) &&
          isVerified() &&
          isOwner(userId) &&
          exists(/databases/$(database)/documents/users/$(userId)) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId) &&
          isVerified() &&
          isOwner(userId) &&
          isValidUserPrivateInfo(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt']);
        allow delete: if false;
      }
    }
  }
}
